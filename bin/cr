#!/usr/bin/env sh

set -eu

__CR_INITIALIZED__=0

_CR_INSTALL_DIR=""
_CR_USAGE_EXIT_CODE=2
_CR_ERROR_EXIT_CODE=1
_CR_SUCCESS_EXIT_CODE=0
EOL='
'
_CR_DIR_NAME=".coderail"

_coderail_init()
{
    if [ ! "$__CR_INITIALIZED__" -eq 0 ]; then
        return
    fi
    __CR_INITIALIZED__=1
    script_path=$1

    while [ -L "$script_path" ]; do
        script_dir=$(
            CDPATH= cd -- "$(dirname "$script_path")"
            pwd
        )
        link_target=$(readlink "$script_path")

        case "$link_target" in
            /*) script_path=$link_target ;;
            *) script_path=$script_dir/$link_target ;;
        esac
    done

    _CR_INSTALL_DIR=$(
        cd -- "$(dirname "$script_path")/.."
        pwd
    )

    _CR_TEMP_RESOURCE_FILE="${TMPDIR:-/tmp}/coderail-$$.resources"
    if [ ! : > "$_CR_TEMP_RESOURCE_FILE" ]; then
        log_error "Failed to create temporary resource file"
        return 1
    fi
}

_coderail_init "$0"

. "$_CR_INSTALL_DIR/lib/utils/log.sh"
. "$_CR_INSTALL_DIR/lib/utils/conf.sh"
. "$_CR_INSTALL_DIR/lib/utils/fs.sh"
. "$_CR_INSTALL_DIR/lib/utils/yaml.sh"
. "$_CR_INSTALL_DIR/lib/utils/text.sh"

register_temp_resource()
{
    resource="$1"
    printf '%s\n' "$resource" >> "$_CR_TEMP_RESOURCE_FILE"
}

usage() {
    cat <<'EOF'
Usage:
  cr [options] <command>

  CodeRail CLI tool for agent-based development

Options:
  -h, --help             Show this help message and exit
      --version          Show version information and exit
  -v, --verbose          Enable verbose logging
  -q, --quiet            Suppress notices and log output
      --cwd <dir>        Specify the current working directory
      --no-color         Disable colored output
      --non-interactive  Disable prompts and interactive output

Commands:
  init                 Initialize current directory for CodeRail
  install              Install CodeRail for specific agent harnesses
  uninstall            Uninstall CodeRail for specific agent harnesses
  doctor               Inspect or repair broken CodeRail state
  idea                 Manage ideas
  status               Show status of current working directory
  ticket               Manage tickets
  loop                 Implement tickets in a loop
  test                 Run defined tests for files and directories

Environment Variables:
  NO_COLOR=1           Disable colored output
  NON_INTERACTIVE=1    Disable prompts and interactive output
  LOG_LEVEL=verbose|quiet
                       Set log level to verbose or quiet
EOF
}

version() {
    . "$_CR_INSTALL_DIR/lib/version.sh"
    output "cr version $coderail_version"
}

_cleanup_on_exit()
{
    _status=$?
    log_verbose "Cleaning up temporary resources"
    trap - 0 HUP INT TERM

    _log_cleanup
    if [ -f "$_CR_TEMP_RESOURCE_FILE" ]; then
        awk '
            { resources[NR] = $0 }
            END {
                for (i = NR; i >= 1; i--)
                    print resources[i]
            }
        ' "$_CR_TEMP_RESOURCE_FILE" |
        while IFS= read -r resource; do
            [ -n "$resource" ] || continue
            rm -rf "$resource" 2>/dev/null || :
        done
        rm -f "$_CR_TEMP_RESOURCE_FILE"
    fi

    exit "$_status"
}

trap '_cleanup_on_exit' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

load_config "$@"
argi=0

while [ $argi -lt $argc ]; do
    eval "arg=\$argv_$argi"
    case "$arg" in
        --)
            argi=$((argi + 1))
            break
            ;;
        -h|--help)
            usage
            exit "$_CR_SUCCESS_EXIT_CODE"
            ;;
        --help=*)
            log_error "--help does not take an argument"
            usage >&2
            exit "$_CR_USAGE_EXIT_CODE"
            ;;
        --version)
            version
            exit "$_CR_SUCCESS_EXIT_CODE"
            ;;
        --version=*)
            log_error "--version does not take an argument"
            usage >&2
            exit "$_CR_USAGE_EXIT_CODE"
            ;;
        -*)
            log_error "Unknown option: $arg"
            usage >&2
            exit "$_CR_USAGE_EXIT_CODE"
            ;;
        *)
            break
            ;;
    esac
    argi=$((argi + 1))
done

eval "command=\$argv_$argi"
argi=$((argi + 1))

set --
while [ $argi -lt $argc ]; do
    eval "set -- \"\$@\" \"\$argv_$argi\""
    argi=$((argi + 1))
done

command=$(basename "$command")
script="$_CR_INSTALL_DIR/lib/commands/$command.sh"

if [ ! -f "$script" ]; then
    log_error "Unknown command: \"$command\""
    usage >&2
    exit "$_CR_USAGE_EXIT_CODE"
fi

if [ ! -d "$cwd" ]; then
    log_error "Working directory does not exist: \"$cwd\""
    exit "$_CR_ERROR_EXIT_CODE"
fi

cd "$cwd"
(
    . "$script"
    execute_command "$@"
)
