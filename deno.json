{
    "exclude": ["./assets", "./bin"],
    "imports": {
        "@mutasaurus/mutasaurus": "jsr:@mutasaurus/mutasaurus@^0.1.5",
        "@std/expect": "jsr:@std/expect@^1.0.20",
        "@std/path": "jsr:@std/path@^1.1.6",
        "@path": "./src/path.ts",
        "@fs": "./src/fs.ts",
        "@conf": "./src/conf.ts",
        "@log": "./src/log.ts",
        "@cli": "./src/cli.ts",
        "@commands": "./src/commands.ts",
        "@runtime": "./src/runtime.ts",
        "@md": "./src/md.ts",
        "@harness": "./src/harness.ts",
        "@utils": "./src/utils.ts",
        "@install-manifest": "./src/install-manifest.ts",
        "@templates": "./src/templates.ts",
        "oxc-parser": "npm:oxc-parser@^0.153.0",
        "@project": "./src/project.ts",
        "@tickets": "./src/tickets.ts",
        "@installation": "./src/installation.ts"
    },
    "coverage": {
        "thresholds": {
            "branches": 100,
            "functions": 100,
            "lines": 100
        }
    },
    "compilerOptions": {
        "noUncheckedIndexedAccess": true
    },
    "fmt": {
        "include": []
    },
    "lint": {
        "include": []
    },
    "format": {
        "include": []
    }
}
