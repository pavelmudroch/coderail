{
    "deno.enable": true,
    "markdown.validate.enabled": true,
    "editor.formatOnSave": true,
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": ".(ts)",
                "cmd": "cd \"${workspaceFolder}\" && bun fmt --no-script \"${file}\"",
                "autoShowOutputPanel": "error"
            }
        ]
    }
}